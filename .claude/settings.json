{
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=zlsopfgynkdakzbxaizj"
    }
  },
  "permissions": {
    "allow": [
      "Bash(open *)",
      "Bash(curl -s *)",
      "Bash(dig *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-no-verify.cjs"
          }
        ]
      }
    ]
  }
}

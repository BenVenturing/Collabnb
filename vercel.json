{
  "buildCommand": "npm run build",
  "installCommand": "npm install && cd app && npm install",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    { "source": "/profile.html", "destination": "/profile", "permanent": true }
  ],
  "rewrites": [
    { "source": "/explore",        "destination": "/app/index.html" },
    { "source": "/profile",        "destination": "/app/index.html" },
    { "source": "/profile/:path*", "destination": "/app/index.html" },
    { "source": "/host",           "destination": "/app/index.html" },
    { "source": "/host/:path*",    "destination": "/app/index.html" },
    { "source": "/collabs",        "destination": "/app/index.html" },
    { "source": "/saved",          "destination": "/app/index.html" },
    { "source": "/inbox",          "destination": "/app/index.html" },
    { "source": "/listing/:path*", "destination": "/app/index.html" },
    { "source": "/contract",       "destination": "/app/index.html" },
    { "source": "/admin",          "destination": "/app/index.html" },
    { "source": "/blog",           "destination": "/app/index.html" },
    { "source": "/blog/:path*",    "destination": "/app/index.html" }
  ]
}
